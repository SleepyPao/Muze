{
  "name": "maze-rescue",
  "version": "0.1.0",
  "private": true,
  "description": "Maze Rescue - English-learning browser game prototype (no build step, no runtime dependencies)",
  "scripts": {
    "test": "node --test tests/",
    "test:e2e": "node tests/e2e/playthrough.js",
